<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://gitlab.gnome.org/GNOME/glib/-/raw/HEAD/gio/gschema.dtd"?>
<schemalist>
	<enum id="org.gnome.shell.extensions.copious-touch.ClipboardHistory">
		<value nick="clear" value="0"/>
		<value nick="keep-pinned-and-tagged" value="1"/>
		<value nick="keep-all" value="2"/>
	</enum>

	<enum id="org.gnome.shell.extensions.copious-touch.Orientation">
		<value nick="horizontal" value="0"/>
		<value nick="vertical" value="1"/>
	</enum>

	<enum id="org.gnome.shell.extensions.copious-touch.Position">
		<value nick="top" value="0"/>
		<value nick="center" value="1"/>
		<value nick="bottom" value="2"/>
		<value nick="fill" value="3"/>
	</enum>

	<enum id="org.gnome.shell.extensions.copious-touch.HeaderControlsVisibility">
		<value nick="visible" value="0"/>
		<value nick="visible-on-hover" value="1"/>
		<value nick="hidden" value="2"/>
	</enum>

	<enum id="org.gnome.shell.extensions.copious-touch.OpenClipboardDialogBehavior">
		<value nick="toggle" value="0"/>
		<value nick="open-or-select-next" value="1"/>
	</enum>

	<enum id="org.gnome.shell.extensions.copious-touch.MiddleClickAction">
		<value nick="none" value="0"/>
		<value nick="pin" value="1"/>
		<value nick="delete" value="2"/>
	</enum>

	<enum id="org.gnome.shell.extensions.copious-touch.IndicatorDisplay">
		<value nick="hidden" value="0"/>
		<value nick="icon-only" value="1"/>
		<value nick="clipboard-content-only" value="2"/>
		<value nick="icon-and-clipboard-content" value="3"/>
	</enum>

	<enum id="org.gnome.shell.extensions.copious-touch.TextCountMode">
		<value nick="characters" value="0"/>
		<value nick="words" value="1"/>
		<value nick="lines" value="2"/>
	</enum>

	<enum id="org.gnome.shell.extensions.copious-touch.BackgroundSize">
		<value nick="cover" value="0"/>
		<value nick="contain" value="1"/>
	</enum>

	<enum id="org.gnome.shell.extensions.copious-touch.DrawerTheme">
		<value nick="solid" value="0"/>
		<value nick="transparent" value="1"/>
	</enum>

	<flags id="org.gnome.shell.extensions.copious-touch.file-item.FilePreviewType">
		<value nick="text" value="1"/>
		<value nick="image" value="2"/>
		<value nick="thumbnail" value="4"/>
	</flags>

	<enum id="org.gnome.shell.extensions.copious-touch.file-item.FilePreviewVisibility">
		<value nick="file-preview" value="0"/>
		<value nick="file-info" value="1"/>
		<value nick="file-preview-or-file-info" value="2"/>
		<value nick="file-preview-and-file-info" value="3"/>
		<value nick="hidden" value="4"/>
	</enum>

	<schema id="org.gnome.shell.extensions.copious-touch" path="/org/gnome/shell/extensions/copious-touch/">
		<!-- State -->
		<key name="incognito" type="b">
			<default>false</default>
			<summary>Do not record clipboard history</summary>
		</key>

		<!-- History -->
		<key name="database-location" type="s">
			<default>''</default>
			<summary>Custom path to the database. Defaults to {XDG_DATA_HOME}/{EXTENSION UUID}/clipboard.json</summary>
		</key>
		<key name="clipboard-history" enum="org.gnome.shell.extensions.copious-touch.ClipboardHistory">
			<default>'keep-pinned-and-tagged'</default>
			<summary>Retention policy for clipboard history on restart or logout</summary>
		</key>
		<key name="history-length" type="i">
			<default>50</default>
			<range min="10" max="500"/>
			<summary>Number of unpinned items to keep</summary>
		</key>
		<key name="history-time" type="i">
			<default>1440</default>
			<range min="0" max="525600"/>
			<summary>Retention time in minutes (0 to disable)</summary>
		</key>

		<!-- Behavior -->
		<key name="remember-search" type="b">
			<default>false</default>
			<summary>Remember the last search</summary>
		</key>
		<key name="exclude-pinned" type="b">
			<default>false</default>
			<summary>Pinned items appear only when searching for pinned items</summary>
		</key>
		<key name="exclude-tagged" type="b">
			<default>false</default>
			<summary>Tagged items appear only when searching for tagged items</summary>
		</key>
		<key name="protect-pinned" type="b">
			<default>true</default>
			<summary>Prevents pinned items from being auto-deleted</summary>
		</key>
		<key name="protect-tagged" type="b">
			<default>true</default>
			<summary>Prevents tagged items from being auto-deleted</summary>
		</key>
		<key name="sync-primary" type="b">
			<default>false</default>
			<summary>Sync with primary X11/Wayland selection</summary>
		</key>
		<key name="update-date-on-copy" type="b">
			<default>true</default>
			<summary>Update timestamp when an item is selected from history</summary>
		</key>

		<!-- Feedback -->
		<key name="indicator-display" enum="org.gnome.shell.extensions.copious-touch.IndicatorDisplay">
			<default>'icon-only'</default>
			<summary>How the clipboard indicator appears in the top panel</summary>
		</key>
		<key name="wiggle-indicator" type="b">
			<default>true</default>
			<summary>Animate the indicator when a new item is captured</summary>
		</key>
		<key name="send-notification" type="b">
			<default>false</default>
			<summary>Send notification on copy</summary>
		</key>
		<key name="sound" type="s">
			<choices>
				<choice value="none"/>
				<choice value="click"/>
				<choice value="hum"/>
				<choice value="string"/>
				<choice value="swing"/>
				<choice value="message"/>
				<choice value="message-new-instant"/>
				<choice value="bell"/>
				<choice value="dialog-warning"/>
			</choices>
			<default>'none'</default>
			<summary>Sound effect on copy</summary>
		</key>
		<key name="volume" type="d">
			<default>0.0</default>
			<range min="-20.0" max="20.0"/>
			<summary>Sound volume offset in dB</summary>
		</key>

		<!-- App Exclusions -->
		<key name="wmclass-exclusions" type="as">
			<default>[]</default>
			<summary>WM_CLASS list of excluded applications</summary>
		</key>

		<!-- Dialog & Drawer Layout -->
		<key name="show-at-pointer" type="b">
			<default>false</default>
			<summary>Show dialog at pointer position</summary>
		</key>
		<key name="show-at-cursor" type="b">
			<default>false</default>
			<summary>Show dialog at text cursor</summary>
		</key>
		<key name="clipboard-orientation" enum="org.gnome.shell.extensions.copious-touch.Orientation">
			<default>'horizontal'</default>
			<summary>Orientation of the drawer</summary>
		</key>
		<key name="clipboard-position-vertical" enum="org.gnome.shell.extensions.copious-touch.Position">
			<default>'top'</default>
			<summary>Vertical position of the drawer</summary>
			<aliases>
				<alias value="left" target="top"/>
				<alias value="right" target="bottom"/>
			</aliases>
		</key>
		<key name="clipboard-position-horizontal" enum="org.gnome.shell.extensions.copious-touch.Position">
			<default>'fill'</default>
			<summary>Horizontal position of the drawer</summary>
			<aliases>
				<alias value="left" target="top"/>
				<alias value="right" target="bottom"/>
			</aliases>
		</key>
		<key name="clipboard-size" type="i">
			<default>500</default>
			<range min="200" max="10000"/>
			<summary>Dimension along orientation axis</summary>
		</key>
		<key name="clipboard-margin-top" type="i">
			<default>0</default>
			<range min="0" max="1000"/>
			<summary>Top margin</summary>
		</key>
		<key name="clipboard-margin-right" type="i">
			<default>0</default>
			<range min="0" max="1000"/>
			<summary>Right margin</summary>
		</key>
		<key name="clipboard-margin-bottom" type="i">
			<default>4</default>
			<range min="0" max="1000"/>
			<summary>Bottom margin</summary>
		</key>
		<key name="clipboard-margin-left" type="i">
			<default>0</default>
			<range min="0" max="1000"/>
			<summary>Left margin</summary>
		</key>
		<key name="auto-hide-search" type="b">
			<default>false</default>
			<summary>Automatically collapse search bar when not typing</summary>
		</key>
		<key name="show-scrollbar" type="b">
			<default>true</default>
			<summary>Show scrollbar when items overflow</summary>
		</key>
		<key name="drawer-theme" enum="org.gnome.shell.extensions.copious-touch.DrawerTheme">
			<default>'solid'</default>
			<summary>Drawer background theme style (solid or transparent)</summary>
		</key>

		<!-- Item Cards -->
		<key name="item-width" type="i">
			<default>250</default>
			<range min="150" max="1000"/>
			<summary>Width of a card item</summary>
		</key>
		<key name="item-height" type="i">
			<default>180</default>
			<range min="50" max="1000"/>
			<summary>Height of a card item</summary>
		</key>
		<key name="dynamic-item-height" type="b">
			<default>false</default>
			<summary>Dynamically adjust height</summary>
		</key>
		<key name="tab-width" type="i">
			<default>4</default>
			<range min="1" max="8"/>
			<summary>Tab width</summary>
		</key>

		<!-- Card Header Controls -->
		<key name="show-header" type="b">
			<default>true</default>
			<summary>Show header on cards</summary>
		</key>
		<key name="header-controls-visibility" enum="org.gnome.shell.extensions.copious-touch.HeaderControlsVisibility">
			<default>'visible'</default>
			<summary>Visibility of touch/mouse action controls</summary>
		</key>
		<key name="show-item-title" type="b">
			<default>true</default>
			<summary>Show item title</summary>
		</key>

		<!-- Item Type Schemas -->
		<child name="text-item" schema="org.gnome.shell.extensions.copious-touch.text-item"/>
		<child name="code-item" schema="org.gnome.shell.extensions.copious-touch.code-item"/>
		<child name="image-item" schema="org.gnome.shell.extensions.copious-touch.image-item"/>
		<child name="file-item" schema="org.gnome.shell.extensions.copious-touch.file-item"/>
		<child name="link-item" schema="org.gnome.shell.extensions.copious-touch.link-item"/>

		<!-- Shortcuts -->
		<key name="open-clipboard-dialog-shortcut" type="as">
			<default>['&lt;Super&gt;v']</default>
			<summary>Shortcut to open the clipboard drawer</summary>
		</key>
		<key name="toggle-incognito-mode-shortcut" type="as">
			<default>['&lt;Super&gt;&lt;Control&gt;&lt;Shift&gt;v']</default>
			<summary>Shortcut to toggle incognito mode</summary>
		</key>
		<key name="open-clipboard-dialog-behavior" enum="org.gnome.shell.extensions.copious-touch.OpenClipboardDialogBehavior">
			<default>'toggle'</default>
			<summary>Behavior of open shortcut</summary>
		</key>

		<key name="pin-item-shortcut" type="as">
			<default>['&lt;Control&gt;s']</default>
			<summary>Shortcut to pin an item</summary>
		</key>
		<key name="delete-item-shortcut" type="as">
			<default>['Delete']</default>
			<summary>Shortcut to delete an item</summary>
		</key>
		<key name="edit-item-shortcut" type="as">
			<default>['&lt;Control&gt;e']</default>
			<summary>Shortcut to edit an item</summary>
		</key>
		<key name="edit-title-shortcut" type="as">
			<default>['&lt;Control&gt;t']</default>
			<summary>Shortcut to edit title</summary>
		</key>
		<key name="open-menu-shortcut" type="as">
			<default>['&lt;Control&gt;a']</default>
			<summary>Shortcut to open action menu</summary>
		</key>
		<key name="toggle-pinned-search-shortcut" type="as">
			<default>['Alt']</default>
			<summary>Shortcut to filter pinned items</summary>
		</key>
		<key name="middle-click-action" enum="org.gnome.shell.extensions.copious-touch.MiddleClickAction">
			<default>'pin'</default>
			<summary>Action on middle mouse click</summary>
		</key>
		<key name="swap-copy-shortcut" type="b">
			<default>false</default>
			<summary>Swap copy and paste shortcuts</summary>
		</key>
		<key name="swap-scroll-shortcut" type="b">
			<default>false</default>
			<summary>Swap scroll cycle shortcuts</summary>
		</key>
	</schema>

	<schema id="org.gnome.shell.extensions.copious-touch.text-item" path="/org/gnome/shell/extensions/copious-touch/text-item/">
		<key name="show-text-info" type="b">
			<default>false</default>
			<summary>Show extra info</summary>
		</key>
		<key name="text-count-mode" enum="org.gnome.shell.extensions.copious-touch.TextCountMode">
			<default>'characters'</default>
			<summary>Count mode</summary>
		</key>
	</schema>

	<schema id="org.gnome.shell.extensions.copious-touch.code-item" path="/org/gnome/shell/extensions/copious-touch/code-item/">
		<key name="syntax-highlighting" type="b">
			<default>true</default>
			<summary>Enable syntax highlighting</summary>
		</key>
		<key name="show-line-numbers" type="b">
			<default>true</default>
			<summary>Show line numbers</summary>
		</key>
		<key name="show-code-info" type="b">
			<default>false</default>
			<summary>Show code info</summary>
		</key>
		<key name="text-count-mode" enum="org.gnome.shell.extensions.copious-touch.TextCountMode">
			<default>'characters'</default>
			<summary>Count mode</summary>
		</key>
	</schema>

	<schema id="org.gnome.shell.extensions.copious-touch.image-item" path="/org/gnome/shell/extensions/copious-touch/image-item/">
		<key name="show-image-info" type="b">
			<default>false</default>
			<summary>Show image info</summary>
		</key>
		<key name="background-size" enum="org.gnome.shell.extensions.copious-touch.BackgroundSize">
			<default>'cover'</default>
			<summary>Background sizing</summary>
		</key>
	</schema>

	<schema id="org.gnome.shell.extensions.copious-touch.file-item" path="/org/gnome/shell/extensions/copious-touch/file-item/">
		<key name="file-preview-visibility" enum="org.gnome.shell.extensions.copious-touch.file-item.FilePreviewVisibility">
			<default>'file-preview-or-file-info'</default>
			<summary>Preview visibility</summary>
		</key>
		<key name="file-preview-types" flags="org.gnome.shell.extensions.copious-touch.file-item.FilePreviewType">
			<default>['text','image','thumbnail']</default>
			<summary>Preview types</summary>
		</key>
		<key name="file-preview-exclusion-patterns" type="as">
			<default>[]</default>
			<summary>Exclusion patterns</summary>
		</key>
		<key name="background-size" enum="org.gnome.shell.extensions.copious-touch.BackgroundSize">
			<default>'cover'</default>
			<summary>Background sizing</summary>
		</key>
		<key name="syntax-highlighting" type="b">
			<default>true</default>
			<summary>Syntax highlighting</summary>
		</key>
		<key name="show-line-numbers" type="b">
			<default>true</default>
			<summary>Show line numbers</summary>
		</key>
	</schema>

	<schema id="org.gnome.shell.extensions.copious-touch.link-item" path="/org/gnome/shell/extensions/copious-touch/link-item/">
		<key name="show-link-preview" type="b">
			<default>true</default>
			<summary>Show link preview</summary>
		</key>
		<key name="show-link-preview-image" type="b">
			<default>true</default>
			<summary>Show link preview image</summary>
		</key>
		<key name="link-preview-image-background-size" enum="org.gnome.shell.extensions.copious-touch.BackgroundSize">
			<default>'contain'</default>
			<summary>Preview image size</summary>
		</key>
		<key name="link-preview-orientation" enum="org.gnome.shell.extensions.copious-touch.Orientation">
			<default>'vertical'</default>
			<summary>Orientation</summary>
		</key>
		<key name="link-preview-exclusion-patterns" type="as">
			<default>[]</default>
			<summary>Exclusion patterns</summary>
		</key>
	</schema>
</schemalist>
